@@ -73,6 +76,42 @@
 namespace {
 
 #if !BUILDFLAG(IS_ANDROID)
+// Suppress only the exact fail-closed DNS guard used with one explicit SOCKS5
+// IPv4 proxy. Redirects, quoted/unparseable rules, bypasses and other bad flags
+// must retain their normal warnings. This changes UI only, never DNS behavior.
+bool IsRestrictedSocksDnsGuard(const base::CommandLine& command_line) {
+  if (command_line.HasSwitch(switches::kNoProxyServer) ||
+      command_line.HasSwitch(switches::kProxyAutoDetect) ||
+      command_line.HasSwitch(switches::kProxyPacUrl) ||
+      command_line.HasSwitch(network::switches::kHostRules)) {
+    return false;
+  }
+  if (command_line.HasSwitch(switches::kProxyBypassList) &&
+      command_line.GetSwitchValueASCII(switches::kProxyBypassList) !=
+          "<-loopback>") {
+    return false;
+  }
+  const std::string proxy_uri =
+      command_line.GetSwitchValueASCII(switches::kProxyServer);
+  const net::ProxyServer proxy =
+      net::ProxyUriToProxyServer(proxy_uri, net::ProxyServer::SCHEME_HTTP);
+  if (!proxy.is_valid() || proxy.scheme() != net::ProxyServer::SCHEME_SOCKS5 ||
+      proxy.host_port_pair().port() == 0 ||
+      proxy_uri != "socks5://" + proxy.host_port_pair().ToString()) {
+    return false;
+  }
+  net::IPAddress address;
+  if (!address.AssignFromIPLiteral(proxy.host_port_pair().host()) ||
+      !address.IsIPv4()) {
+    return false;
+  }
+  const std::string rules =
+      command_line.GetSwitchValueASCII(network::switches::kHostResolverRules);
+  const std::string exclusion = ", EXCLUDE " + address.ToString();
+  return rules == "MAP * ~NOTFOUND" + exclusion ||
+         rules == "MAP * ~NOTFOUND " + exclusion;
+}
+
 // Dangerous command line flags for which to display a warning that "stability
 // and security will suffer".
 const char* const kBadFlags[] = {
@@ -266,6 +305,11 @@
